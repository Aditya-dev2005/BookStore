@model BookStore.Models.Order
@{
    ViewData["Title"] = "Checkout";
    var cartItems = ViewBag.CartItems as List<BookStore.Models.CartItem>;
    decimal total = 0;
}

<h1>Checkout</h1>

<h4>Order Summary</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in cartItems)
        {
            decimal subtotal = item.Book.Price * item.Quantity;
            total += subtotal;
            <tr>
                <td>@item.Book.Title</td>
                <td>@item.Book.Price</td>
                <td>@item.Quantity</td>
                <td>@subtotal</td>
            </tr>
        }
    </tbody>
</table>
<h4>Total: @total</h4>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="PlaceOrder" method="post">
            <div class="form-group">
                <label asp-for="CustomerName" class="control-label"></label>
                <input asp-for="CustomerName" class="form-control" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CustomerAddress" class="control-label"></label>
                <input asp-for="CustomerAddress" class="form-control" />
                <span asp-validation-for="CustomerAddress" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <input type="submit" value="Confirm Order" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
